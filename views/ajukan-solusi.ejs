<%- include('partials/head', { title: 'Ajukan Solusi Riset' }) %>
<%- include('partials/nav', { active: 'tantangan' }) %>

<main class="page-container section-narrow">
  <header class="page-header-center">
    <h1 class="page-title">Ajukan Solusi Riset untuk Industri</h1>
    <p class="page-desc">Tawarkan pendekatan ilmiah, prototipe, atau hasil riset laboratorium Anda untuk menyelesaikan permasalahan nyata mitra industri.</p>
  </header>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert-box alert-success">
      <svg class="alert-icon sk-icon" width="20" height="20" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#certificate"/></svg>
      <div>
        <strong>Proposal Solusi Terkirim!</strong>
        <p>Solusi Anda telah diterima oleh P2KI LPPM dan akan segera direview sebelum dipresentasikan kepada perwakilan perusahaan terkait.</p>
      </div>
    </div>
  <% } %>

  <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
    <div class="alert-box alert-danger">
      <svg class="alert-icon sk-icon" width="20" height="20" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#alert"/></svg>
      <div>
        <strong>Pengisian Belum Lengkap</strong>
        <p><%= errorMsg %></p>
      </div>
    </div>
  <% } %>

  <% if (challengeItem) { %>
    <div class="selected-entity-card">
      <div class="entity-icon bg-amber-subtle">
        <svg width="22" height="22" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#industry"/></svg>
      </div>
      <div class="entity-meta">
        <span class="entity-badge">Menjawab Tantangan Industri</span>
        <h4 class="entity-title"><%= challengeItem.judul %></h4>
        <p class="entity-sub">Mitra: <strong><%= challengeItem.perusahaan %></strong> · Batas: <%= challengeItem.deadline_fmt %></p>
      </div>
    </div>
  <% } %>

  <!-- SSO SISFO BOX -->
  <div class="sso-modern-card">
    <div class="sso-left">
      <div class="sso-logo-box">
        <svg width="22" height="22" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#lock"/></svg>
      </div>
      <div>
        <h3 class="sso-title">Masuk Cepat dengan Akun SISFO</h3>
        <p class="sso-subtitle">Isi nama peneliti dan fakultas otomatis dari database kepegawaian.</p>
      </div>
    </div>
    <button class="btn-sso-action" type="button" onclick="sisfoLoginSolusi()" id="sisfoBtnSolusi">
      <svg width="16" height="16" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#check"/></svg>
      <span>Tautkan SISFO</span>
    </button>
  </div>

  <form class="modern-form-card" method="POST" action="/ajukan-solusi">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <input type="hidden" name="challenge_id" value="<%= challengeItem ? challengeItem.id : '' %>">

    <div class="form-grid-2">
      <div class="form-group">
        <label class="form-label" for="sNama">Nama Peneliti Utama <span class="required-mark">*</span></label>
        <input type="text" class="form-input" name="nama_peneliti" id="sNama" placeholder="Terisi otomatis atau ketik manual" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="sFakultas">Fakultas / Laboratorium</label>
        <input type="text" class="form-input" name="fakultas" id="sFakultas" placeholder="Contoh: F. Kedokteran / Lab Rekayasa">
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="sRingkasan">Ringkasan Pendekatan Solusi <span class="required-mark">*</span></label>
      <textarea class="form-textarea" name="ringkasan" id="sRingkasan" rows="5" placeholder="Jelaskan metode ilmiah, bahan yang digunakan, estimasi durasi, dan keunggulan pendekatan Anda dibandingkan metode konvensional..." required></textarea>
    </div>

    <div class="form-group">
      <label class="form-label" for="sKi">KI Terkait yang Sudah Ada (Opsional)</label>
      <input type="text" class="form-input" name="ki_terkait" id="sKi" placeholder="Contoh: Paten No. IDS00000... atau Judul KI yang terdaftar">
      <span class="form-helper">Jika solusi ini merupakan turunan dari paten atau karya cipta yang sudah terdaftar di UNISBA.</span>
    </div>

    <div class="form-footer-action">
      <button class="btn-primary-glow btn-block" type="submit">
        <svg width="18" height="18" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#send"/></svg>
        <span>Kirim Proposal Solusi Riset</span>
      </button>
      <p class="form-disclaimer">Proposal akan dienkripsi dan dijamin kerahasiaan akademisnya oleh LPPM UNISBA.</p>
    </div>
  </form>
</main>

<script>
function sisfoLoginSolusi(){
  document.getElementById('sNama').value = 'Dr. Ilman Abidin, S.H., M.H.';
  document.getElementById('sFakultas').value = 'Fakultas Hukum';
  ['sNama','sFakultas'].forEach(id => {
    const el = document.getElementById(id);
    if(el) el.classList.add('input-locked');
  });
  const btn = document.getElementById('sisfoBtnSolusi');
  btn.innerHTML = `<svg width="16" height="16" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#check"/></svg><span>Terhubung SISFO</span>`;
  btn.classList.add('connected');
  btn.disabled = true;
}
</script>

<%- include('partials/footer') %>
