<% const fv = typeof values !== "undefined" ? values : {}; const fe = typeof fieldErrors !== "undefined" ? fieldErrors : {}; const fieldIds = {"nama_peneliti": "sNama", "fakultas": "sFakultas", "ringkasan": "sRingkasan", "ki_terkait": "sKi"}; %>
<%- include('partials/head', { title: 'Ajukan Solusi Riset' }) %>
<%- include('partials/nav', { active: 'tantangan' }) %>

<main id="mainContent" tabindex="-1" class="page-container section-narrow">
  <header class="page-header-center">
    <h1 class="page-title">Ajukan Solusi Riset untuk Industri</h1>
    <p class="page-desc">Tawarkan pendekatan ilmiah, prototipe, atau hasil riset laboratorium Anda untuk menyelesaikan permasalahan nyata mitra industri.</p>
  </header>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert-box alert-success">
      <svg class="alert-icon sk-icon" width="20" height="20" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=1a3db9681d#certificate"/></svg>
      <div>
        <strong>Proposal Solusi Terkirim!</strong>
        <p>Solusi Anda telah diterima oleh P2KI LPPM dan akan segera direview sebelum dipresentasikan kepada perwakilan perusahaan terkait.</p>
      </div>
    </div>
  <% } %>


  <% if (challengeItem) { %>
    <div class="selected-entity-card">
      <div class="entity-icon bg-amber-subtle">
        <svg width="22" height="22" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=1a3db9681d#industry"/></svg>
      </div>
      <div class="entity-meta">
        <span class="entity-badge">Menjawab Tantangan Industri</span>
        <h4 class="entity-title"><%= challengeItem.judul %></h4>
        <p class="entity-sub">Mitra: <strong><%= challengeItem.perusahaan %></strong> · Batas: <%= challengeItem.deadline_fmt %></p>
      </div>
    </div>
  <% } %>

  <p class="service-note">Isi identitas Anda secara manual. Integrasi akun SISFO belum tersedia.</p>

  <%- include("partials/form-errors", { fe, fieldIds }) %>

  <form class="modern-form-card" method="POST" action="/ajukan-solusi">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <input type="hidden" name="challenge_id" value="<%= challengeItem ? challengeItem.id : '' %>">

    <div class="form-grid-2">
      <div class="form-group">
        <label class="form-label" for="sNama">Nama Peneliti Utama <span class="required-mark">*</span></label>
        <input type="text" class="form-input" name="nama_peneliti" id="sNama" placeholder="Nama lengkap peneliti" required value="<%= fv.nama_peneliti || '' %>" maxlength="200" aria-invalid="<%= !!fe.nama_peneliti %>" <%- fe.nama_peneliti ? 'aria-describedby="sNama-error"' : '' %>>
        <% if (fe.nama_peneliti) { %><span class="field-error" id="sNama-error"><%= fe.nama_peneliti %></span><% } %>
      </div>

      <div class="form-group">
        <label class="form-label" for="sFakultas">Fakultas / Laboratorium</label>
        <input type="text" class="form-input" name="fakultas" id="sFakultas" placeholder="Contoh: F. Kedokteran / Lab Rekayasa" value="<%= fv.fakultas || '' %>" maxlength="200" aria-invalid="<%= !!fe.fakultas %>" <%- fe.fakultas ? 'aria-describedby="sFakultas-error"' : '' %>>
        <% if (fe.fakultas) { %><span class="field-error" id="sFakultas-error"><%= fe.fakultas %></span><% } %>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="sRingkasan">Ringkasan Pendekatan Solusi <span class="required-mark">*</span></label>
      <textarea class="form-textarea" name="ringkasan" id="sRingkasan" rows="5" placeholder="Jelaskan metode ilmiah, bahan yang digunakan, estimasi durasi, dan keunggulan pendekatan Anda dibandingkan metode konvensional..." required aria-invalid="<%= !!fe.ringkasan %>" <%- fe.ringkasan ? 'aria-describedby="sRingkasan-error"' : '' %> maxlength="5000"><%= fv.ringkasan || '' %></textarea>
        <% if (fe.ringkasan) { %><span class="field-error" id="sRingkasan-error"><%= fe.ringkasan %></span><% } %>
    </div>

    <div class="form-group">
      <label class="form-label" for="sKi">KI Terkait yang Sudah Ada (Opsional)</label>
      <input type="text" class="form-input" name="ki_terkait" id="sKi" placeholder="Contoh: Paten No. IDS00000... atau Judul KI yang terdaftar" value="<%= fv.ki_terkait || '' %>" maxlength="200" aria-invalid="<%= !!fe.ki_terkait %>" <%- fe.ki_terkait ? 'aria-describedby="sKi-error"' : '' %>>
        <% if (fe.ki_terkait) { %><span class="field-error" id="sKi-error"><%= fe.ki_terkait %></span><% } %>
      <span class="form-helper">Jika solusi ini merupakan turunan dari paten atau karya cipta yang sudah terdaftar di UNISBA.</span>
    </div>

    <div class="form-footer-action">
      <button class="btn-primary-glow btn-block" type="submit">
        <svg width="18" height="18" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=1a3db9681d#send"/></svg>
        <span>Kirim Proposal Solusi Riset</span>
      </button>
      <p class="form-disclaimer">Sampaikan ringkasan non-rahasia untuk peninjauan awal oleh tim P2KI.</p>
    </div>
  </form>
</main>


<%- include('partials/footer') %>
