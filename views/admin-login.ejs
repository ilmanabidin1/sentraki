<%- include('partials/head', { title: 'Login Admin' }) %>

<main id="mainContent" tabindex="-1" class="auth-page-container">
  <div class="auth-card">
    <div class="auth-brand-center">
      <img src="/brand/p2ki-blue-gold-v1.webp" alt="Logo P2KI UNISBA — Idea, Protect, Impact" width="600" height="600" class="auth-logo">
      <h1 class="auth-title">P2KI UNISBA</h1>
      <p class="auth-subtitle">Portal Manajemen Internal &amp; Kurasi LPPM</p>
    </div>

    <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
      <div class="alert-box alert-danger" style="margin-bottom: 20px;">
        <svg class="alert-icon sk-icon" width="18" height="18" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#alert"/></svg>
        <div><%= errorMsg %></div>
      </div>
    <% } %>

    <form class="auth-form" method="POST" action="/admin/login">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

      <div class="form-group">
        <label class="form-label" for="adminUsername">Username Administrator</label>
        <div class="auth-input-wrap">
          <svg class="auth-input-icon sk-icon" width="16" height="16" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#user"/></svg>
          <input type="text" class="form-input with-icon" name="username" id="adminUsername" placeholder="Ketik username admin" required autofocus>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="adminPassword">Kata Sandi</label>
        <div class="auth-input-wrap">
          <svg class="auth-input-icon sk-icon" width="16" height="16" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#lock"/></svg>
          <input type="password" class="form-input with-icon" name="password" id="adminPassword" placeholder="••••••••" required>
        </div>
      </div>

      <button class="btn-primary-glow btn-block" type="submit" style="margin-top: 12px;">
        <span>Masuk ke Dasbor Internal</span>
        <svg width="16" height="16" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#right"/></svg>
      </button>
    </form>

    <div class="auth-footer-links">
      <a href="/" class="auth-back-link">
        <svg width="14" height="14" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#left"/></svg>
        <span>Kembali ke Beranda Publik</span>
      </a>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
