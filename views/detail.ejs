<%- include('partials/head', { title: item.judul }) %>
<%- include('partials/nav', { active: 'direktori' }) %>

<main class="page-container">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Beranda</a>
    <span class="breadcrumb-sep">/</span>
    <a href="/direktori">Direktori Inovasi KI</a>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-current"><%= item.judul %></span>
  </nav>

  <div class="detail-layout">
    <!-- LEFT MAIN COLUMN -->
    <div class="detail-main-col">
      <div class="detail-header-card">
        <div class="card-top-row">
          <span class="badge-type <%= item.jenis.toLowerCase().replace(/\s+/g, '-') %>"><%= item.jenis %><%= item.subtipe ? ' · ' + item.subtipe : '' %></span>
          <span class="badge-status-pill badge-<%= item.status %>">
            <span class="status-dot"></span>
            <span><%= item.status === 'granted' ? (item.jenis === 'Hak Cipta' ? 'Tercatat Resmi' : 'Granted (Diberikan)') : (item.status === 'ditolak' ? 'Ditolak / Ditarik' : 'Dalam Proses (' + (item.status_raw || 'Pemeriksaan') + ')') %></span>
          </span>
        </div>

        <h1 class="detail-title"><%= item.judul %></h1>

        <!-- DOCKET METADATA CHIPS -->
        <div class="docket-chips-row">
          <% if (item.jenis === 'Paten') { %>
            <div class="docket-chip">
              <span class="docket-label">No. Permohonan:</span>
              <strong class="docket-value"><%= item.no_permohonan || 'Dalam Pencatatan' %></strong>
            </div>
            <% if (item.no_reg) { %>
              <div class="docket-chip">
                <span class="docket-label">No. Sertifikat Paten:</span>
                <strong class="docket-value text-emerald"><%= item.no_reg %></strong>
              </div>
            <% } %>
          <% } else if (item.jenis === 'Hak Cipta') { %>
            <div class="docket-chip">
              <span class="docket-label">No. Pencatatan:</span>
              <strong class="docket-value"><%= item.no_reg || item.no_permohonan || 'Dalam Proses' %></strong>
            </div>
          <% } else { %>
            <div class="docket-chip">
              <span class="docket-label">No. Berkas Resmi:</span>
              <strong class="docket-value"><%= item.no_permohonan || item.no_reg || 'Dalam Proses' %></strong>
            </div>
          <% } %>

          <% if (item.tahun) { %>
            <div class="docket-chip">
              <span class="docket-label">Tahun:</span>
              <strong class="docket-value"><%= item.tahun %></strong>
            </div>
          <% } %>
        </div>
      </div>

      <!-- DESKRIPSI & RINGKASAN RISET -->
      <div class="detail-section-card">
        <h2 class="detail-card-heading">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          <span>Deskripsi Invensi &amp; Karya Riset</span>
        </h2>
        <div class="detail-text-body">
          <% if (item.deskripsi) { %>
            <p><%= item.deskripsi %></p>
          <% } else { %>
            <p>
              Kekayaan Intelektual berjenis <strong><%= item.jenis %></strong><%= item.subtipe ? ' (' + item.subtipe + ')' : '' %> merupakan hasil riset civitas akademika <strong><%= item.fakultas %></strong> Universitas Islam Bandung atas nama <strong><%= item.inventor %></strong><%= item.tahun ? ', diajukan/tercatat tahun ' + item.tahun : '' %>.
            </p>
            <% if (item.status === 'granted') { %>
              <p>Invensi ini telah resmi berstatus <strong><%= item.status_raw || 'Granted' %></strong> di Direktorat Jenderal Kekayaan Intelektual (DJKI) Republik Indonesia dan memiliki perlindungan hukum eksklusif.</p>
            <% } else { %>
              <p>Invensi saat ini berada dalam tahapan pemeriksaan administratif/substantif dengan status terkini: <strong><%= item.status_raw || 'Dalam Proses' %></strong>.</p>
            <% } %>
          <% } %>
        </div>

        <div class="legal-notice-box">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <div>
            <strong>Kerahasiaan &amp; Hak Eksklusif</strong>
            <p>Klaim teknis mendalam dan spesifikasi formulasi dilindungi hukum. Mitra industri yang berminat dapat mengajukan minat kerja sama untuk mengakses informasi terperinci di bawah Perjanjian Kerahasiaan (NDA).</p>
          </div>
        </div>

        <div class="detail-tags-row">
          <span class="detail-tag-pill"><%= item.jenis %></span>
          <% if (item.subtipe) { %><span class="detail-tag-pill"><%= item.subtipe %></span><% } %>
          <span class="detail-tag-pill"><%= item.fakultas %></span>
          <% if (item.tahun) { %><span class="detail-tag-pill">Tahun <%= item.tahun %></span><% } %>
        </div>
      </div>

      <!-- CTA CARD -->
      <div class="detail-cta-card">
        <div>
          <h3 class="cta-card-title">Tertarik Bermitra atau Melisensi Inovasi Ini?</h3>
          <p class="cta-card-desc">Ajukan minat kerja sama resmi melalui formulir terstruktur P2KI. Tim kami akan memfasilitasi temu teknis dengan inventor.</p>
        </div>
        <div class="cta-card-buttons">
          <a class="btn-primary-glow" href="/ajukan-minat?ki=<%= item.id %>">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
            <span>Ajukan Minat Kerja Sama</span>
          </a>
          <button type="button" class="btn-secondary-white" onclick="copyCurrentUrl()" id="btnShare">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            <span id="btnShareText">Bagikan Tautan</span>
          </button>
        </div>
      </div>
    </div>

    <!-- RIGHT SIDEBAR -->
    <aside class="detail-sidebar">
      <!-- INVENTOR CARD -->
      <div class="sidebar-card">
        <h3 class="sidebar-card-title">Inventor &amp; Pemegang Hak</h3>
        <div class="inventor-profile">
          <div class="inventor-avatar">
            <%= (item.inventor || 'U').charAt(0).toUpperCase() %>
          </div>
          <div class="inventor-info">
            <div class="inventor-name"><%= item.inventor %></div>
            <div class="inventor-faculty"><%= item.fakultas %></div>
            <div class="inventor-univ">Universitas Islam Bandung</div>
          </div>
        </div>
        <div class="verified-badge-row">
          <span class="verified-icon">✓</span>
          <span>Data terverifikasi resmi oleh LPPM UNISBA</span>
        </div>
      </div>

      <!-- LEGAL PDKI DJKI CARD -->
      <div class="sidebar-card">
        <h3 class="sidebar-card-title">Verifikasi Portal DJKI</h3>
        <p class="sidebar-card-desc">Cek keabsahan data langsung pada basis data Pangkalan Data Kekayaan Intelektual (PDKI) Kemenkumham RI.</p>

        <div class="pdki-action-list">
          <% if (item.link) { %>
            <a class="btn-pdki-direct" href="<%= item.link %>" target="_blank" rel="noopener">
              <span>Buka Dokumen Resmi di PDKI</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          <% } %>

          <a class="btn-pdki-search" href="<%= pdkiSearchUrl %>" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span>Telusuri Nomor di Database PDKI</span>
          </a>
        </div>
        <div class="pdki-tip-text">
          Tautan otomatis mengisi kata kunci nomor <%= item.no_reg || item.no_permohonan ? 'resmi' : 'judul' %> pada sistem DJKI.
        </div>
      </div>

      <!-- HELP CALLOUT -->
      <div class="sidebar-card help-card">
        <div class="help-card-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <h4 class="help-card-title">Butuh Pendampingan Teknis?</h4>
        <p class="help-card-desc">Tim P2KI siap membantu penjajakan komersial, konsultasi skema lisensi, dan klarifikasi status hukum.</p>
        <a href="/konsultasi" class="btn-help-chat">
          <span>Chat dengan Admin P2KI</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
    </aside>
  </div>
</main>

<script>
function copyCurrentUrl() {
  navigator.clipboard.writeText(window.location.href).then(() => {
    const btn = document.getElementById('btnShareText');
    const prev = btn.textContent;
    btn.textContent = 'Tautan Disalin! ✓';
    setTimeout(() => { btn.textContent = prev; }, 2500);
  });
}
</script>

<%- include('partials/footer') %>
