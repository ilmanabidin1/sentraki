<%- include('partials/head', { title: 'Dasbor Administrator' }) %>

<div class="admin-app-wrapper">
  <!-- TOP ADMIN BAR -->
  <header class="admin-topbar-modern">
    <div class="admin-topbar-left">
      <div class="admin-title">Portal Manajemen &amp; Kurasi P2KI UNISBA</div>
    </div>
    <div class="admin-topbar-right">
      <span class="admin-user-info">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>Masuk sebagai: <strong><%= username %></strong></span>
      </span>
      <span class="admin-sep">|</span>
      <a href="/" class="admin-nav-action">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        <span>Lihat Portal Publik</span>
      </a>
      <span class="admin-sep">|</span>
      <a href="/admin/logout" class="admin-nav-logout">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        <span>Keluar</span>
      </a>
    </div>
  </header>

  <main class="admin-main-container">
    <div class="admin-header-title">
      <div>
        <h1 class="page-title" style="font-size: 26px;">Dasbor Manajemen Inovasi &amp; Kemitraan</h1>
        <p class="page-desc">Rekapitulasi inventaris kekayaan intelektual, antrean tinjauan berkas pengajuan, dan proposal solusi industri.</p>
      </div>
    </div>

    <!-- KPI CARDS -->
    <div class="admin-kpi-grid">
      <div class="admin-kpi-card">
        <div class="kpi-icon-wrap bg-blue-subtle">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
        </div>
        <div class="kpi-num"><%= kpi.totalKI.toLocaleString('id-ID') %></div>
        <div class="kpi-label">Total KI Tercatat</div>
        <div class="kpi-sub">Database LPPM UNISBA</div>
      </div>

      <div class="admin-kpi-card">
        <div class="kpi-icon-wrap bg-amber-subtle">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="kpi-num text-amber"><%= kpi.pendingReview %></div>
        <div class="kpi-label">Menunggu Tinjauan Konten</div>
        <div class="kpi-sub">Pengajuan baru dari dosen</div>
      </div>

      <div class="admin-kpi-card">
        <div class="kpi-icon-wrap bg-emerald-subtle">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
        </div>
        <div class="kpi-num text-emerald"><%= kpi.interestCount %></div>
        <div class="kpi-label">Minat Kerja Sama Masuk</div>
        <div class="kpi-sub">Permohonan dari industri</div>
      </div>

      <div class="admin-kpi-card">
        <div class="kpi-icon-wrap bg-indigo-subtle">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="12 8 8 12 12 16 12 8"/></svg>
        </div>
        <div class="kpi-num"><%= kpi.challengeActive %></div>
        <div class="kpi-label">Tantangan Industri Aktif</div>
        <div class="kpi-sub">Program Link &amp; Match terbuka</div>
      </div>
    </div>

    <!-- TABLE 1: TANTANGAN INDUSTRI & SOLUSI -->
    <div class="admin-table-card">
      <div class="admin-table-header">
        <h3 class="admin-table-title">Tantangan Industri &amp; Proposal Solusi Masuk</h3>
        <span class="admin-table-badge"><%= challenges.length %> data terbaru</span>
      </div>
      <div class="admin-table-responsive">
        <table class="modern-table">
          <thead>
            <tr>
              <th>Kode</th>
              <th>Kebutuhan Riset</th>
              <th>Perusahaan Mitra</th>
              <th>Solusi Masuk</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (challenges.length === 0) { %>
              <tr><td colspan="5" class="table-empty-row">Belum ada tantangan industri yang terdaftar.</td></tr>
            <% } %>
            <% challenges.forEach(c => { %>
              <tr>
                <td class="mono font-semibold"><%= c.kode %></td>
                <td><strong><%= c.judul %></strong></td>
                <td><%= c.perusahaan %></td>
                <td>
                  <span class="badge-pill-count"><%= c.solusi_count %> Proposal</span>
                </td>
                <td>
                  <span class="badge-status-pill <%= c.status === 'terbuka' ? 'badge-granted' : 'badge-proses' %>">
                    <span class="status-dot"></span>
                    <span><%= c.status === 'terbuka' ? 'Terbuka' : 'Segera Ditutup' %></span>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- TABLE 2: PENGAJUAN MINAT KERJA SAMA -->
    <div class="admin-table-card">
      <div class="admin-table-header">
        <h3 class="admin-table-title">Pengajuan Minat Kerja Sama Terkini</h3>
        <span class="admin-table-badge"><%= interests.length %> data terbaru</span>
      </div>
      <div class="admin-table-responsive">
        <table class="modern-table">
          <thead>
            <tr>
              <th>Pemohon / Institusi</th>
              <th>KI Terkait</th>
              <th>Jenis Kerja Sama</th>
              <th>Status Tindak Lanjut</th>
            </tr>
          </thead>
          <tbody>
            <% if (interests.length === 0) { %>
              <tr><td colspan="4" class="table-empty-row">Belum ada permohonan minat kerja sama masuk.</td></tr>
            <% } %>
            <% interests.forEach(i => { %>
              <tr>
                <td>
                  <strong><%= i.institusi || i.nama %></strong>
                  <div class="table-subtext"><%= i.email || '-' %></div>
                </td>
                <td><%= i.judul || 'Konsultasi Umum' %></td>
                <td>
                  <span class="badge-pill-neutral"><%= i.jenis_kebutuhan %></span>
                </td>
                <td>
                  <span class="badge-status-pill badge-proses">
                    <span class="status-dot"></span>
                    <span><%= i.status %></span>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- TABLE 3: KI PENDING REVIEW -->
    <div class="admin-table-card">
      <div class="admin-table-header">
        <h3 class="admin-table-title">Pengajuan Inovasi Baru — Menunggu Tinjauan LPPM</h3>
        <span class="admin-table-badge"><%= pendingKI.length %> antrean</span>
      </div>
      <div class="admin-table-responsive">
        <table class="modern-table">
          <thead>
            <tr>
              <th>Judul Inovasi</th>
              <th>Inventor Utama</th>
              <th>Fakultas</th>
              <th>Jenis &amp; Status DJKI</th>
            </tr>
          </thead>
          <tbody>
            <% if (pendingKI.length === 0) { %>
              <tr><td colspan="4" class="table-empty-row">Semua pengajuan telah ditinjau dan ditayangkan.</td></tr>
            <% } %>
            <% pendingKI.forEach(k => { %>
              <tr>
                <td><strong><%= k.judul %></strong></td>
                <td><%= k.inventor %></td>
                <td><%= k.fakultas %></td>
                <td>
                  <span class="badge-pill-neutral"><%= k.jenis %></span>
                  <span class="table-subtext"><%= k.status_raw || 'Pemeriksaan' %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('partials/footer') %>
