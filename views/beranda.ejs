<%- include('partials/head', { title: 'Beranda' }) %>
<%- include('partials/nav', { active: 'beranda' }) %>

<main id="mainContent" tabindex="-1">
<!-- HERO SECTION -->
<section class="hero-section">
  <div class="hero-artwork-bg" aria-hidden="true"></div>
  <div class="hero-container">
    <h1 class="hero-title">
      Inovasi Kampus Terkurasi,<br>
      <span class="gradient-text">Solusi Nyata bagi Industri.</span>
    </h1>

    <p class="hero-desc">
      Menjembatani lebih dari 1.200 kekayaan intelektual (Paten, Hak Cipta, Merek, Desain Industri) civitas akademika UNISBA dengan kebutuhan pasar, investor, dan mitra industri melalui direktori dan formulir pengajuan kerja sama.
    </p>

    <!-- HERO SEARCH BAR -->
    <form class="hero-search-form" action="/direktori" method="GET">
      <div class="hero-search-input-wrap">
        <svg class="search-icon sk-icon" width="20" height="20" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#search"/></svg>
        <input type="text" name="q" class="hero-search-input" placeholder="Cari inovasi: formulasi herbal, teknologi digital, desain kemasan, nama inventor..." aria-label="Cari inovasi direktori">
      </div>
      <button type="submit" class="btn-hero-search">
        <span>Cari Inovasi</span>
        <svg width="16" height="16" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#right"/></svg>
      </button>
    </form>

    <div class="hero-quick-tags">
      <span class="quick-tag-label">Pencarian Populer:</span>
      <a href="/direktori?jenis=Paten&status=granted" class="quick-tag-pill">Paten Granted</a>
      <a href="/direktori?jenis=Hak+Cipta" class="quick-tag-pill">Hak Cipta Riset</a>
      <a href="/direktori?q=kesehatan" class="quick-tag-pill">Kesehatan &amp; Obat</a>
      <a href="/direktori?q=teknologi" class="quick-tag-pill">Teknologi Rekayasa</a>
      <a href="/direktori?q=syariah" class="quick-tag-pill">Ekonomi Syariah</a>
    </div>

    <!-- HERO METRIC STATS -->
    <div class="hero-stats-grid">
      <div class="hero-stat-card">
        <div class="stat-card-top">
          <div class="stat-icon bg-blue-subtle">
            <svg width="22" height="22" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#collection"/></svg>
          </div>
          <span class="stat-growth-tag">Terdaftar</span>
        </div>
        <div class="hero-stat-num"><%= stats.total.toLocaleString('id-ID') %>+</div>
        <div class="hero-stat-lbl">Total KI dalam Rekap</div>
        <div class="hero-stat-sub">Paten, Desain, Merek &amp; Hak Cipta</div>
      </div>

      <div class="hero-stat-card">
        <div class="stat-card-top">
          <div class="stat-icon bg-emerald-subtle">
            <svg width="22" height="22" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#certificate"/></svg>
          </div>
          <span class="stat-growth-tag granted-tag">Granted</span>
        </div>
        <div class="hero-stat-num text-emerald"><%= stats.grantedPatenDI.toLocaleString('id-ID') %></div>
        <div class="hero-stat-lbl">Paten &amp; Desain Granted</div>
        <div class="hero-stat-sub">Status dalam rekap KI Unisba</div>
      </div>

      <div class="hero-stat-card">
        <div class="stat-card-top">
          <div class="stat-icon bg-amber-subtle">
            <svg width="22" height="22" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#people"/></svg>
          </div>
          <span class="stat-growth-tag">Kolaboratif</span>
        </div>
        <div class="hero-stat-num text-amber"><%= stats.fakultas %></div>
        <div class="hero-stat-lbl">Fakultas Aktif Berinovasi</div>
        <div class="hero-stat-sub">Riset multidisiplin ilmu terapan</div>
      </div>

      <div class="hero-stat-card">
        <div class="stat-card-top">
          <div class="stat-icon bg-indigo-subtle">
            <svg width="22" height="22" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#portfolio"/></svg>
          </div>
          <span class="stat-growth-tag">Kemenkumham</span>
        </div>
        <div class="hero-stat-num">4</div>
        <div class="hero-stat-lbl">Kategori KI Tercakup</div>
        <div class="hero-stat-sub">Sesuai klasifikasi DJKI RI</div>
      </div>
    </div>
  </div>
</section>

<!-- PERSONA ENTRY PATHWAYS -->
<section class="section persona-section">
  <div class="section-header-center">
    <h2 class="section-title">Pintu Masuk Terpadu Sentra KI</h2>
    <p class="section-subtitle">Pilih jalur yang sesuai dengan profil Anda untuk memulai kolaborasi yang tepat guna dan terstruktur.</p>
  </div>

  <div class="persona-grid">
    <!-- Persona 1: Mitra Industri -->
    <div class="persona-card">
      <div class="persona-icon bg-blue-subtle">
        <svg width="28" height="28" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#patent"/></svg>
      </div>
      <h3 class="persona-title">Cari Inovasi untuk Kolaborasi</h3>
      <p class="persona-desc">Telusuri karya dalam rekap KI Unisba dan ajukan minat untuk membahas peluang pemanfaatannya.</p>
      <ul class="persona-features">
        <li><svg class="sk-icon" width="16" height="16" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#check"/></svg> Akses deskripsi non-teknis terkurasi</li>
        <li><svg class="sk-icon" width="16" height="16" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#check"/></svg> Tautan penelusuran ke portal PDKI</li>
        <li><svg class="sk-icon" width="16" height="16" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#check"/></svg> Fasilitasi skema royalti transparan</li>
      </ul>
      <a href="/direktori" class="persona-btn btn-blue">
        <span>Buka Katalog Inovasi</span>
        <svg width="14" height="14" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#right"/></svg>
      </a>
    </div>

    <!-- Persona 2: Dosen & Peneliti -->
    <div class="persona-card highlighted-persona">
      <div class="persona-icon bg-amber-subtle">
        <svg width="28" height="28" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#book"/></svg>
      </div>
      <h3 class="persona-title">Daftarkan &amp; Lindungi Karya</h3>
      <p class="persona-desc">Ajukan karya hasil penelitian untuk ditinjau tim P2KI LPPM sebelum dipublikasikan dalam direktori.</p>
      <ul class="persona-features">
        <li><svg class="sk-icon" width="16" height="16" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#check"/></svg> Pengisian identitas dan fakultas</li>
        <li><svg class="sk-icon" width="16" height="16" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#check"/></svg> Bantuan penelusuran novelty &amp; drafting</li>
        <li><svg class="sk-icon" width="16" height="16" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#check"/></svg> Informasi skema manfaat ekonomi</li>
      </ul>
      <a href="/daftarkan-ki" class="persona-btn btn-gold">
        <span>Daftarkan KI Sekarang</span>
        <svg width="14" height="14" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#right"/></svg>
      </a>
    </div>

    <!-- Persona 3: Kebutuhan Tantangan -->
    <div class="persona-card">
      <div class="persona-icon bg-emerald-subtle">
        <svg width="28" height="28" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#industry"/></svg>
      </div>
      <h3 class="persona-title">Tantangan Kebutuhan Industri</h3>
      <p class="persona-desc">Pasang permasalahan riil industri Anda atau ajukan solusi riset aplikatif dari laboratorium UNISBA untuk kemitraan strategis.</p>
      <ul class="persona-features">
        <li><svg class="sk-icon" width="16" height="16" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#check"/></svg> Pasang kebutuhan riset spesifik</li>
        <li><svg class="sk-icon" width="16" height="16" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#check"/></svg> Dapatkan proposal solusi pakar dosen</li>
        <li><svg class="sk-icon" width="16" height="16" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#check"/></svg> Model riset bersama atau pembiayaan</li>
      </ul>
      <a href="/tantangan-industri" class="persona-btn btn-emerald">
        <span>Jelajahi Tantangan</span>
        <svg width="14" height="14" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#right"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- 3-STAGE HILIRISASI FLOW -->
<section class="section section-alt">
  <div class="section-container">
    <div class="section-header-center">
      <h2 class="section-title">Bagaimana Hilirisasi Inovasi Berjalan?</h2>
      <p class="section-subtitle">P2KI UNISBA mengawal proses dari penelusuran awal hingga perlindungan hukum dan perjanjian komersial.</p>
    </div>

    <div class="flow-steps-grid">
      <div class="flow-step-card">
        <div class="flow-step-number">01</div>
        <div class="flow-step-icon">
          <svg width="24" height="24" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#search"/></svg>
        </div>
        <h3 class="flow-step-title">Eksplorasi Inovasi</h3>
        <p class="flow-step-desc">Mitra industri menelusuri inovasi berdasarkan jenis KI, fakultas, tahun pengajuan, dan status dalam rekap.</p>
        <div class="flow-step-footer">
          <span>Katalog publik terbuka 24/7</span>
        </div>
      </div>

      <div class="flow-step-card">
        <div class="flow-step-number">02</div>
        <div class="flow-step-icon">
          <svg width="24" height="24" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#register"/></svg>
        </div>
        <h3 class="flow-step-title">Pengajuan Minat Resmi</h3>
        <p class="flow-step-desc">Calon mitra mengirimkan formulir minat kerja sama yang langsung masuk ke meja kurasi LPPM, menjaga kerahasiaan inventor.</p>
        <div class="flow-step-footer">
          <span>Pengajuan masuk untuk ditinjau</span>
        </div>
      </div>

      <div class="flow-step-card">
        <div class="flow-step-number">03</div>
        <div class="flow-step-icon">
          <svg width="24" height="24" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#people-verified"/></svg>
        </div>
        <h3 class="flow-step-title">Perjanjian &amp; Lisensi</h3>
        <p class="flow-step-desc">P2KI memfasilitasi temu teknis, negosiasi skema royalti yang berkeadilan, hingga penandatanganan MoU dan kontrak lisensi.</p>
        <div class="flow-step-footer">
          <span>Diskusi skema pemanfaatan</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FEATURED INNOVATIONS SECTION -->
<section class="section">
  <div class="section-container">
    <div class="section-head-between">
      <div>
        <h2 class="section-title">Kekayaan Intelektual Unggulan</h2>
        <p class="section-subtitle">Pilihan invensi berstatus granted dalam rekap KI Unisba. Kesiapan komersialisasi memerlukan peninjauan lebih lanjut.</p>
      </div>
      <a class="btn-outline-action" href="/direktori">
        <span>Lihat Semua 1.200+ Inovasi</span>
        <svg width="14" height="14" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#right"/></svg>
      </a>
    </div>

    <div class="ki-cards-grid">
      <% featured.forEach(item => { %>
        <article class="ki-modern-card">
          <div class="card-top-row">
            <span class="badge-type <%= item.jenis.toLowerCase().replace(/\s+/g, '-') %>"><%- include('partials/ki-icon', { jenis: item.jenis }) %><%= item.jenis %></span>
            <span class="badge-status-pill badge-<%= item.status %>">
              <span class="status-dot"></span>
              <span><%= item.status === 'granted' ? 'Granted' : (item.status === 'ditolak' ? 'Ditolak' : 'Dalam Proses') %></span>
            </span>
          </div>

          <h3 class="card-title">
            <a href="/direktori/<%= item.id %>"><%= item.judul %></a>
          </h3>

          <div class="card-meta-list">
            <div class="meta-item">
              <svg width="14" height="14" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#user"/></svg>
              <span class="meta-inventor"><%= item.inventor %></span>
            </div>
            <div class="meta-item">
              <svg width="14" height="14" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#home"/></svg>
              <span class="meta-fakultas"><%= item.fakultas %></span>
            </div>
          </div>

          <div class="card-action-footer">
            <a href="/direktori/<%= item.id %>" class="card-link-detail">
              <span>Detail Invensi</span>
              <svg width="12" height="12" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#chevron-right"/></svg>
            </a>
            <a href="/ajukan-minat?ki=<%= item.id %>" class="card-btn-action">
              <span>Ajukan Minat</span>
            </a>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- AI ASSISTANT & KONSULTASI CALLOUT -->
<section class="section section-alt">
  <div class="section-container">
    <div class="ai-cta-banner">
      <div class="ai-cta-content">
        <h2 class="ai-cta-title">Masih Bingung Prosedur Pendaftaran atau Royalti?</h2>
        <p class="ai-cta-desc">Pelajari materi KI atau gunakan panduan otomatis untuk memahami alur pendaftaran dan pemanfaatan karya.</p>
        <div class="ai-cta-actions">
          <a href="/pelajari-ki" class="btn-primary-glow">
            <svg width="16" height="16" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#book"/></svg>
            <span>Buka Akademi KI &amp; AI</span>
          </a>
          <a href="/konsultasi" class="btn-secondary-white">
            <svg width="16" height="16" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#consult"/></svg>
            <span>Panduan Konsultasi</span>
          </a>
        </div>
      </div>
      <div class="ai-cta-visual">
        <div class="ai-bubble-preview">
          <div class="ai-preview-header">
            <div class="ai-avatar-mini">AI</div>
            <div>
              <div class="ai-preview-name">Asisten Sentra KI</div>
              <div class="ai-preview-status">Online · Siap Menjawab</div>
            </div>
          </div>
          <div class="ai-preview-text">"Paten melindungi invensi teknologi baru selama 20 tahun, sedangkan Hak Cipta melindungi wujud ekspresi karya cipta sejak pertama kali dipublikasikan."</div>
          <div class="ai-preview-tags">
            <span>#Paten</span>
            <span>#HakCipta</span>
            <span>#BagiHasilRoyalti</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

</main>
<%- include('partials/footer') %>
