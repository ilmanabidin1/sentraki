<%- include('partials/head', { title: 'Beranda' }) %>
<%- include('partials/nav', { active: 'beranda' }) %>

<!-- HERO SECTION -->
<section class="hero-section">
  <div class="hero-glow-1"></div>
  <div class="hero-glow-2"></div>
  <div class="hero-container">
    <div class="hero-badge">
      <span class="live-pulse"></span>
      <span>PORTAL RESMI HILIRISASI RISET &amp; SENTRA KI UNISBA</span>
    </div>

    <h1 class="hero-title">
      Inovasi Kampus Terkurasi,<br>
      <span class="gradient-text">Solusi Nyata bagi Industri.</span>
    </h1>

    <p class="hero-desc">
      Menjembatani lebih dari 1.200 kekayaan intelektual (Paten, Hak Cipta, Merek, Desain Industri) civitas akademika UNISBA dengan kebutuhan pasar, investor, dan mitra industri secara terstruktur dan terverifikasi SISFO.
    </p>

    <!-- HERO SEARCH BAR -->
    <form class="hero-search-form" action="/direktori" method="GET">
      <div class="hero-search-input-wrap">
        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" name="q" class="hero-search-input" placeholder="Cari inovasi: formulasi herbal, teknologi digital, desain kemasan, nama inventor..." aria-label="Cari inovasi direktori">
      </div>
      <button type="submit" class="btn-hero-search">
        <span>Cari Inovasi</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </button>
    </form>

    <div class="hero-quick-tags">
      <span class="quick-tag-label">Pencarian Populer:</span>
      <a href="/direktori?jenis=Paten&status=granted" class="quick-tag-pill">Paten Granted</a>
      <a href="/direktori?jenis=Hak+Cipta" class="quick-tag-pill">Hak Cipta Riset</a>
      <a href="/direktori?q=kesehatan" class="quick-tag-pill">Kesehatan &amp; Obat</a>
      <a href="/direktori?q=teknologi" class="quick-tag-pill">Teknologi Rekayasa</a>
      <a href="/direktori?q=syariah" class="quick-tag-pill">Ekonomi Syariah</a>
    </div>

    <!-- HERO METRIC STATS -->
    <div class="hero-stats-grid">
      <div class="hero-stat-card">
        <div class="stat-card-top">
          <div class="stat-icon bg-blue-subtle">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          </div>
          <span class="stat-growth-tag">Terdaftar</span>
        </div>
        <div class="hero-stat-num"><%= stats.total.toLocaleString('id-ID') %>+</div>
        <div class="hero-stat-lbl">Total KI Tercatat Resmi</div>
        <div class="hero-stat-sub">Paten, Desain, Merek &amp; Hak Cipta</div>
      </div>

      <div class="hero-stat-card">
        <div class="stat-card-top">
          <div class="stat-icon bg-emerald-subtle">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <span class="stat-growth-tag granted-tag">Siap Lisensi</span>
        </div>
        <div class="hero-stat-num text-emerald"><%= stats.grantedPatenDI.toLocaleString('id-ID') %></div>
        <div class="hero-stat-lbl">Paten &amp; Desain Granted</div>
        <div class="hero-stat-sub">Kepastian hukum perlindungan DJKI</div>
      </div>

      <div class="hero-stat-card">
        <div class="stat-card-top">
          <div class="stat-icon bg-amber-subtle">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <span class="stat-growth-tag">Kolaboratif</span>
        </div>
        <div class="hero-stat-num text-amber"><%= stats.fakultas %></div>
        <div class="hero-stat-lbl">Fakultas Aktif Berinovasi</div>
        <div class="hero-stat-sub">Riset multidisiplin ilmu terapan</div>
      </div>

      <div class="hero-stat-card">
        <div class="stat-card-top">
          <div class="stat-icon bg-indigo-subtle">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <span class="stat-growth-tag">Kemenkumham</span>
        </div>
        <div class="hero-stat-num">4</div>
        <div class="hero-stat-lbl">Kategori KI Tercakup</div>
        <div class="hero-stat-sub">Sesuai klasifikasi DJKI RI</div>
      </div>
    </div>
  </div>
</section>

<!-- PERSONA ENTRY PATHWAYS -->
<section class="section persona-section">
  <div class="section-header-center">
    <div class="badge-pill-blue">Akses Berdasarkan Kebutuhan Anda</div>
    <h2 class="section-title">Pintu Masuk Terpadu Sentra KI</h2>
    <p class="section-subtitle">Pilih jalur yang sesuai dengan profil Anda untuk memulai kolaborasi yang tepat guna dan terstruktur.</p>
  </div>

  <div class="persona-grid">
    <!-- Persona 1: Mitra Industri -->
    <div class="persona-card">
      <div class="persona-icon bg-blue-subtle">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
      </div>
      <div class="persona-badge">Untuk Industri &amp; Investor</div>
      <h3 class="persona-title">Cari Inovasi Siap Lisensi</h3>
      <p class="persona-desc">Telusuri katalog paten teruji, formulasi terdaftar, dan teknologi tepat guna siap komersialisasi dengan pendampingan perjanjian lisensi resmi.</p>
      <ul class="persona-features">
        <li><span>✓</span> Akses deskripsi non-teknis terkurasi</li>
        <li><span>✓</span> Verifikasi status hukum resmi DJKI</li>
        <li><span>✓</span> Fasilitasi skema royalti transparan</li>
      </ul>
      <a href="/direktori" class="persona-btn btn-blue">
        <span>Buka Katalog Inovasi</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <!-- Persona 2: Dosen & Peneliti -->
    <div class="persona-card highlighted-persona">
      <div class="card-ribbon">Civitas UNISBA</div>
      <div class="persona-icon bg-amber-subtle">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      </div>
      <div class="persona-badge text-gold">Untuk Dosen &amp; Peneliti</div>
      <h3 class="persona-title">Daftarkan &amp; Lindungi Karya</h3>
      <p class="persona-desc">Amankan hak cipta dan paten hasil penelitian Anda dengan integrasi SSO SISFO otomatis dan pendampingan substantif tim P2KI LPPM.</p>
      <ul class="persona-features">
        <li><span>✓</span> Sinkronisasi NIDN &amp; fakultas 1-klik</li>
        <li><span>✓</span> Bantuan penelusuran novelty &amp; drafting</li>
        <li><span>✓</span> Hak bagi hasil royalti inventor terjamin</li>
      </ul>
      <a href="/daftarkan-ki" class="persona-btn btn-gold">
        <span>Daftarkan KI Sekarang</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <!-- Persona 3: Kebutuhan Tantangan -->
    <div class="persona-card">
      <div class="persona-icon bg-emerald-subtle">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="12 8 8 12 12 16 12 8"/></svg>
      </div>
      <div class="persona-badge text-emerald">Link &amp; Match Industri</div>
      <h3 class="persona-title">Tantangan Kebutuhan Industri</h3>
      <p class="persona-desc">Pasang permasalahan riil industri Anda atau ajukan solusi riset aplikatif dari laboratorium UNISBA untuk kemitraan strategis.</p>
      <ul class="persona-features">
        <li><span>✓</span> Pasang kebutuhan riset spesifik</li>
        <li><span>✓</span> Dapatkan proposal solusi pakar dosen</li>
        <li><span>✓</span> Model riset bersama atau pembiayaan</li>
      </ul>
      <a href="/tantangan-industri" class="persona-btn btn-emerald">
        <span>Jelajahi Tantangan</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- 3-STAGE HILIRISASI FLOW -->
<section class="section section-alt">
  <div class="section-container">
    <div class="section-header-center">
      <div class="badge-pill-gold">Alur Kerja Sama Terstruktur</div>
      <h2 class="section-title">Bagaimana Hilirisasi Inovasi Berjalan?</h2>
      <p class="section-subtitle">P2KI UNISBA mengawal proses dari penelusuran awal hingga perlindungan hukum dan perjanjian komersial.</p>
    </div>

    <div class="flow-steps-grid">
      <div class="flow-step-card">
        <div class="flow-step-number">01</div>
        <div class="flow-step-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </div>
        <h3 class="flow-step-title">Eksplorasi Inovasi</h3>
        <p class="flow-step-desc">Mitra industri menelusuri inovasi berdasarkan bidang fokus, tingkat kesiapan teknologi (TRL), dan status permohonan di DJKI.</p>
        <div class="flow-step-footer">
          <span>Katalog publik terbuka 24/7</span>
        </div>
      </div>

      <div class="flow-step-card">
        <div class="flow-step-number">02</div>
        <div class="flow-step-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
        </div>
        <h3 class="flow-step-title">Pengajuan Minat Resmi</h3>
        <p class="flow-step-desc">Calon mitra mengirimkan formulir minat kerja sama yang langsung masuk ke meja kurasi LPPM, menjaga kerahasiaan inventor.</p>
        <div class="flow-step-footer">
          <span>Verifikasi dalam 3–5 hari kerja</span>
        </div>
      </div>

      <div class="flow-step-card">
        <div class="flow-step-number">03</div>
        <div class="flow-step-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
        </div>
        <h3 class="flow-step-title">Perjanjian &amp; Lisensi</h3>
        <p class="flow-step-desc">P2KI memfasilitasi temu teknis, negosiasi skema royalti yang berkeadilan, hingga penandatanganan MoU dan kontrak lisensi.</p>
        <div class="flow-step-footer">
          <span>Kerangka bagi hasil resmi</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FEATURED INNOVATIONS SECTION -->
<section class="section">
  <div class="section-container">
    <div class="section-head-between">
      <div>
        <div class="badge-pill-blue">Inovasi Pilihan</div>
        <h2 class="section-title">Kekayaan Intelektual Unggulan</h2>
        <p class="section-subtitle">Invensi dengan status Granted dan kesiapan komersialisasi tinggi hasil karya dosen UNISBA.</p>
      </div>
      <a class="btn-outline-action" href="/direktori">
        <span>Lihat Semua 1.200+ Inovasi</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <div class="ki-cards-grid">
      <% featured.forEach(item => { %>
        <article class="ki-modern-card">
          <div class="card-top-row">
            <span class="badge-type <%= item.jenis.toLowerCase().replace(/\s+/g, '-') %>"><%= item.jenis %></span>
            <span class="badge-status-pill badge-<%= item.status %>">
              <span class="status-dot"></span>
              <span><%= item.status === 'granted' ? 'Granted' : (item.status === 'ditolak' ? 'Ditolak' : 'Dalam Proses') %></span>
            </span>
          </div>

          <h3 class="card-title">
            <a href="/direktori/<%= item.id %>"><%= item.judul %></a>
          </h3>

          <div class="card-meta-list">
            <div class="meta-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <span class="meta-inventor"><%= item.inventor %></span>
            </div>
            <div class="meta-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              <span class="meta-fakultas"><%= item.fakultas %></span>
            </div>
          </div>

          <div class="card-action-footer">
            <a href="/direktori/<%= item.id %>" class="card-link-detail">
              <span>Detail Invensi</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
            <a href="/ajukan-minat?ki=<%= item.id %>" class="card-btn-action">
              <span>Ajukan Minat</span>
            </a>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- AI ASSISTANT & KONSULTASI CALLOUT -->
<section class="section section-alt">
  <div class="section-container">
    <div class="ai-cta-banner">
      <div class="ai-cta-content">
        <div class="ai-cta-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          <span>Pusat Bantuan &amp; Akademi KI Terintegrasi</span>
        </div>
        <h2 class="ai-cta-title">Masih Bingung Prosedur Pendaftaran atau Royalti?</h2>
        <p class="ai-cta-desc">Pelajari rangkuman materi pelatihan DJKI, tanyakan pada Asisten AI P2KI yang terlatih khusus, atau lakukan konsultasi langsung dengan tim kami.</p>
        <div class="ai-cta-actions">
          <a href="/pelajari-ki" class="btn-primary-glow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            <span>Buka Akademi KI &amp; AI</span>
          </a>
          <a href="/konsultasi" class="btn-secondary-white">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            <span>Konsultasi Daring Langsung</span>
          </a>
        </div>
      </div>
      <div class="ai-cta-visual">
        <div class="ai-bubble-preview">
          <div class="ai-preview-header">
            <div class="ai-avatar-mini">AI</div>
            <div>
              <div class="ai-preview-name">Asisten Sentra KI</div>
              <div class="ai-preview-status">Online · Siap Menjawab</div>
            </div>
          </div>
          <div class="ai-preview-text">"Paten melindungi invensi teknologi baru selama 20 tahun, sedangkan Hak Cipta melindungi wujud ekspresi karya cipta sejak pertama kali dipublikasikan."</div>
          <div class="ai-preview-tags">
            <span>#Paten</span>
            <span>#HakCipta</span>
            <span>#BagiHasilRoyalti</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
