<%- include('partials/head', { title: 'Beranda', home: true }) %>
<%- include('partials/nav', { active: 'beranda' }) %>
<main id="mainContent" tabindex="-1" class="premium-home">
  <section class="atlas-opening" aria-labelledby="atlas-title">
    <div class="atlas-banner" aria-hidden="true"><img src="/images/unisba-innovation-banner-v1.webp" width="2167" height="726" alt="" fetchpriority="high" decoding="async"></div>
    <div class="atlas-container">
      <h1 id="atlas-title" class="atlas-title"><span>Inovasi kampus.</span><span>Solusi nyata.</span></h1>
      <div class="atlas-introduction"><p>Temukan kekayaan intelektual Unisba.<br>Hubungkan hasil riset dengan peluang kolaborasi.</p></div>
      <div class="atlas-search-shell"><form class="atlas-search" action="/direktori" method="GET" role="search"><label class="sr-only" for="atlas-search-input">Cari inovasi direktori</label><svg class="sk-icon" width="24" height="24" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#search"/></svg><input id="atlas-search-input" type="search" name="q" placeholder="Judul KI, nama inventor, atau nomor permohonan" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="atlas-search-results"><button type="submit">Telusuri KI <svg class="sk-icon" width="18" height="18" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#right"/></svg></button></form><div class="atlas-suggestions" id="atlas-suggestions" hidden><div id="atlas-search-results" role="listbox" aria-label="Saran hasil pencarian KI"></div><p class="atlas-search-status" id="atlas-search-status" role="status" aria-live="polite"></p><a class="atlas-search-all" id="atlas-search-all" href="/direktori">Lihat semua hasil</a></div></div>
      <nav class="atlas-categories" aria-label="Jelajahi jenis kekayaan intelektual"><% ['Paten', 'Hak Cipta', 'Merek', 'Desain Industri'].forEach(jenis => { %><a href="/direktori?jenis=<%= encodeURIComponent(jenis) %>"><%- include('partials/ki-icon', { jenis }) %><span><%= jenis %></span><svg class="sk-icon category-arrow" width="16" height="16" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#right"/></svg></a><% }) %></nav>
      <div class="atlas-reference"><span><%= stats.total.toLocaleString('id-ID') %> KI dalam rekap</span><span><%= stats.fakultas %> fakultas</span><a href="/status-paten">Lihat status paten <svg class="sk-icon" width="16" height="16" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#right"/></svg></a></div>
    </div>
  </section>
  <section class="portfolio-section" aria-labelledby="portfolio-title"><div class="atlas-container">
    <header class="premium-section-heading"><h2 id="portfolio-title">Di balik setiap invensi,<br>ada gagasan yang berarti.</h2><div><p>Kenali karya dosen Unisba yang berstatus granted dalam rekap. Kesiapan pemanfaatannya dapat dibahas lebih lanjut bersama P2KI.</p><a class="premium-text-link" href="/direktori">Jelajahi seluruh portofolio <svg class="sk-icon" width="18" height="18" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#right"/></svg></a></div></header>
    <div class="portfolio-controls" role="tablist" aria-label="Pilih invensi unggulan" hidden><% featured.forEach((item, i) => { %><button class="portfolio-tab" id="portfolio-tab-<%= i %>" type="button" role="tab" aria-controls="portfolio-panel-<%= i %>" aria-selected="<%= i === 0 %>" tabindex="<%= i === 0 ? 0 : -1 %>"><span class="portfolio-tab-index"><%= String(i + 1).padStart(2, '0') %></span><span><%= item.fakultas %></span><svg class="sk-icon" width="18" height="18" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#right"/></svg></button><% }) %></div>
    <div class="portfolio-leaves"><% featured.forEach((item, i) => { %><article id="portfolio-panel-<%= i %>" class="portfolio-leaf" role="tabpanel" aria-labelledby="portfolio-tab-<%= i %>" tabindex="0"><figure class="portfolio-leaf-mark"><% if (item.illustration) { %><img src="<%= item.illustration.src %>" alt="<%= item.illustration.alt %>" width="768" height="768" loading="lazy" decoding="async"><figcaption>Ilustrasi tema invensi</figcaption><% } else { %><%- include('partials/ki-icon', { jenis: item.jenis }) %><% } %></figure><div class="portfolio-leaf-content"><div class="portfolio-record-meta"><span><%= item.jenis %></span><span>Granted</span><span><%= item.fakultas %></span></div><h3><a href="/direktori/<%= item.id %>"><%= item.judul %></a></h3><p class="portfolio-inventor"><%= item.inventor %></p><div class="portfolio-leaf-actions"><a class="premium-text-link" href="/direktori/<%= item.id %>">Baca detail invensi <svg class="sk-icon" width="18" height="18" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#right"/></svg></a><a class="premium-button" href="/ajukan-minat?ki=<%= item.id %>">Ajukan minat</a></div></div></article><% }) %></div>
  </div></section>
  <section class="premium-services" aria-labelledby="services-title"><div class="atlas-container"><header class="premium-section-heading"><h2 id="services-title">Dari riset.<br>Menuju kesempatan.</h2><p>Pilih langkah yang sesuai dengan kebutuhan Anda. Kami menyediakan ruang untuk pengajuan karya, pencarian mitra, dan pembelajaran KI.</p></header><div class="service-index">
    <a class="service-index-row" href="/daftarkan-ki"><svg class="sk-icon" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#document"/></svg><h3>Daftarkan &amp; lindungi karya</h3><p>Ajukan KI untuk ditinjau tim P2KI sebelum dipublikasikan dalam direktori.</p><svg class="sk-icon service-arrow" width="24" height="24" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#external"/></svg></a>
    <a class="service-index-row" href="/tantangan-industri"><svg class="sk-icon" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#industry"/></svg><h3>Temukan peluang kolaborasi</h3><p>Jelajahi kebutuhan industri, ajukan solusi, atau pasang kebutuhan riset.</p><svg class="sk-icon service-arrow" width="24" height="24" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#external"/></svg></a>
    <a class="service-index-row" href="/pelajari-ki"><svg class="sk-icon" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#book"/></svg><h3>Pahami kekayaan intelektual</h3><p>Pelajari materi KI dan gunakan panduan otomatis untuk pertanyaan umum.</p><svg class="sk-icon service-arrow" width="24" height="24" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#external"/></svg></a>
  </div></div></section>
  <section class="premium-journey" aria-labelledby="journey-title"><div class="atlas-container"><header class="premium-section-heading"><h2 id="journey-title">Langkah yang jelas.<br>Potensi yang terbuka.</h2><a class="premium-text-link" href="/kemitraan">Pelajari alur kemitraan <svg class="sk-icon" width="18" height="18" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#right"/></svg></a></header><ol class="journey-list"><li><span class="journey-step">01</span><h3>Eksplorasi</h3><p>Temukan karya melalui jenis KI, fakultas, status, dan tahun pengajuan.</p></li><li><span class="journey-step">02</span><h3>Ajukan minat</h3><p>Sampaikan kebutuhan dan peluang kerja sama melalui formulir pada detail KI.</p></li><li><span class="journey-step">03</span><h3>Bahas pemanfaatan</h3><p>Lanjutkan penjajakan skema kolaborasi, lisensi, atau pengembangan hasil riset.</p></li></ol></div></section>
  <section class="premium-closing" aria-labelledby="closing-title"><div class="atlas-container"><h2 id="closing-title">Gagasan Anda.<br>Langkah berikutnya.</h2><div><p>Mulai dari karya yang Anda miliki, atau peluang yang ingin Anda temukan.</p><div class="premium-closing-actions"><a class="premium-button" href="/daftarkan-ki">Daftarkan KI <svg class="sk-icon" width="18" height="18" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#plus"/></svg></a><a class="premium-text-link" href="/konsultasi">Buka panduan konsultasi <svg class="sk-icon" width="18" height="18" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#right"/></svg></a></div></div></div></section>
</main>
<%- include('partials/footer') %>
