<%- include('partials/head', { title: 'Direktori KI' }) %>
<%- include('partials/nav', { active: 'direktori' }) %>

<div class="dir-layout">
  <details class="filter-disclosure" id="directoryFilters" open>
    <summary>Filter direktori<%= hasActiveFilter ? ' · aktif' : '' %></summary>
  <form class="filter-box" method="GET" action="/direktori" id="filterForm">
    <input type="hidden" name="sort" value="<%= sort %>">
    <label for="directory-search">Cari kekayaan intelektual</label>
    <input id="directory-search" class="search-box" type="text" name="q" value="<%= query.q || '' %>" placeholder="Judul, inventor, nomor permohonan...">

    <button class="btn-secondary" type="submit">Cari / Terapkan filter</button>
    <p class="filter-help">Angka pilihan mengikuti filter lain yang aktif. Pilih beberapa opsi untuk menggabungkan hasil.</p>
    <div class="filter-group">
      <h4>Jenis KI</h4>
      <% jenisList.forEach(j => { %>
        <label class="filter-opt">
          <span class="filter-opt-label">
            <input type="checkbox" name="jenis" value="<%= j %>" onchange="document.getElementById('filterForm').submit()" <%= selected.jenis && selected.jenis.includes(j) ? 'checked' : '' %>>
            <%= j %>
          </span>
          <span class="filter-opt-count"><%= (jenisCounts[j] || 0).toLocaleString('id-ID') %></span>
        </label>
      <% }) %>
    </div>

    <div class="filter-group">
      <h4>Fakultas</h4>
      <% fakultasList.forEach(f => { %>
        <label class="filter-opt">
          <span class="filter-opt-label">
            <input type="checkbox" name="fakultas" value="<%= f %>" onchange="document.getElementById('filterForm').submit()" <%= selected.fakultas && selected.fakultas.includes(f) ? 'checked' : '' %>>
            <%= f %>
          </span>
          <span class="filter-opt-count"><%= (fakultasCounts[f] || 0).toLocaleString('id-ID') %></span>
        </label>
      <% }) %>
    </div>

    <div class="filter-group">
      <h4>Status permohonan</h4>
      <% Object.entries(statusLabels).forEach(([value, label]) => { %>
        <label class="filter-opt">
          <span class="filter-opt-label"><input type="checkbox" name="status" value="<%= value %>" onchange="this.form.submit()" <%= selected.status.includes(value) ? 'checked' : '' %>><%= label %></span>
          <span class="filter-opt-count"><%= (statusCounts[value] || 0).toLocaleString('id-ID') %></span>
        </label>
      <% }) %>
    </div>
    <div class="filter-group">
      <h4>Tahun</h4>
      <p class="filter-help">Paten: tahun pengajuan. KI lain: tahun sesuai rekap sumber.</p>
      <div class="filter-year-list">
      <% tahunList.forEach(value => { %>
        <label class="filter-opt">
          <span class="filter-opt-label"><input type="checkbox" name="tahun" value="<%= value %>" onchange="this.form.submit()" <%= selected.tahun.includes(value) ? 'checked' : '' %>><%= value === 'unknown' ? 'Belum tersedia' : value %></span>
          <span class="filter-opt-count"><%= (tahunCounts[value] || 0).toLocaleString('id-ID') %></span>
        </label>
      <% }) %>
      </div>
    </div>

    <% if (hasActiveFilter) { %>
      <a class="filter-reset" href="/direktori">Reset semua filter</a>
    <% } %>
    <noscript><button class="btn-secondary" type="submit">Terapkan Filter</button></noscript>
  </form>
  </details>

  <div class="dir-content">
    <section class="patent-summary" aria-labelledby="patent-summary-title">
      <div class="patent-summary-heading"><div><h1 id="patent-summary-title">Pantau status paten</h1>
      <p>Rekap seluruh tahun pengajuan dan status paten, mengikuti pencarian dan fakultas yang dipilih.</p></div>
      <a href="<%= filterUrl({ jenis: ['Paten'], status: [], tahun: [] }) %>">Lihat semua paten →</a></div>
      <div class="patent-stats">
        <% [['total', 'Total paten'], ['granted', 'Granted'], ['proses', 'Dalam proses'], ['ditolak', 'Ditolak / Ditarik']].forEach(([key, label]) => { %>
        <a class="patent-stat patent-stat-<%= key %>" href="<%= filterUrl({ jenis: ['Paten'], status: key === 'total' ? [] : [key], tahun: [] }) %>">
          <span><%= label %></span><strong><%= patentTotals[key].toLocaleString('id-ID') %></strong><small>Lihat paten →</small>
        </a>
        <% }) %>
      </div>
      <details class="patent-breakdown" open>
        <summary>Rincian status per tahun pengajuan</summary>
        <p class="filter-help">Klik jumlah untuk melihat daftar paten. Status adalah status saat ini pada data tersimpan, bukan status historis pada tahun tersebut.</p>
        <div class="patent-table-wrap">
          <table class="patent-table">
            <caption>Jumlah paten berdasarkan tahun pengajuan</caption>
            <thead><tr><th scope="col">Tahun pengajuan</th><th scope="col">Granted</th><th scope="col">Dalam proses</th><th scope="col">Ditolak / Ditarik</th><th scope="col">Total</th></tr></thead>
            <tbody>
            <% patentYears.forEach(row => { %>
              <tr><th scope="row"><%= row.tahun === 'unknown' ? 'Belum tersedia' : row.tahun %></th>
              <% ['granted', 'proses', 'ditolak', 'total'].forEach(key => { %>
                <td><a aria-label="<%= row[key] %> paten <%= key === 'total' ? 'semua status' : statusLabels[key] %>, tahun <%= row.tahun === 'unknown' ? 'belum tersedia' : row.tahun %>" href="<%= filterUrl({ jenis: ['Paten'], status: key === 'total' ? [] : [key], tahun: [row.tahun] }) %>"><%= row[key].toLocaleString('id-ID') %></a></td>
              <% }) %></tr>
            <% }) %>
            <% if (!patentYears.length) { %><tr><td colspan="5">Tidak ada paten untuk pencarian dan fakultas ini.</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </details>
    </section>
    <% if (activeFilters.length) { %><nav class="filter-chips" aria-label="Filter aktif">
      <% activeFilters.forEach(filter => { %><a href="<%= filter.url %>" aria-label="Hapus filter <%= filter.label %>"><%= filter.label %> ×</a><% }) %>
    </nav><% } %>
    <div class="dir-results-head">
      <p>Menampilkan <b><%= items.length %></b> dari <%= total.toLocaleString('id-ID') %> KI tercatat (halaman <%= page %> dari <%= totalPages %>)</p>
      <form method="GET" action="/direktori" id="sortForm">
        <input type="hidden" name="q" value="<%= query.q || '' %>">
        <% (selected.jenis || []).forEach(j => { %><input type="hidden" name="jenis" value="<%= j %>"><% }) %>
        <% (selected.fakultas || []).forEach(f => { %><input type="hidden" name="fakultas" value="<%= f %>"><% }) %>
        <% (selected.status || []).forEach(s => { %><input type="hidden" name="status" value="<%= s %>"><% }) %>
        <% selected.tahun.forEach(t => { %><input type="hidden" name="tahun" value="<%= t %>"><% }) %>
        <select aria-label="Urutan hasil" class="sort-select" name="sort" onchange="document.getElementById('sortForm').submit()">
          <option value="terbaru" <%= sort === 'terbaru' ? 'selected' : '' %>>Tahun terbaru</option>
          <option value="terlama" <%= sort === 'terlama' ? 'selected' : '' %>>Tahun terlama</option>
          <option value="az" <%= sort === 'az' ? 'selected' : '' %>>Abjad A-Z</option>
          <option value="za" <%= sort === 'za' ? 'selected' : '' %>>Abjad Z-A</option>
        </select>
        <noscript><button type="submit" class="btn-secondary">Urutkan</button></noscript>
      </form>
    </div>

    <div class="dir-grid">
      <% if (items.length === 0) { %>
        <p class="empty-note">Tidak ada KI yang cocok dengan filter ini. <a href="/direktori">Reset filter</a> untuk melihat seluruh KI.</p>
      <% } %>
      <% items.forEach(item => { %>
        <a class="ki-card" href="/direktori/<%= item.id %>">
          <div class="ki-top">
            <span class="badge badge-jenis"><%= item.jenis %></span>
            <span class="badge badge-<%= item.status %>"><%= item.status === 'granted' ? (item.jenis === 'Hak Cipta' ? 'Tercatat' : 'Granted') : (item.status === 'ditolak' ? 'Ditolak / Ditarik' : 'Dalam Proses') %></span>
          </div>
          <h3><%= item.judul %></h3>
          <div class="ki-meta">
            <div class="ki-meta-row"><%= item.inventor %></div>
            <div class="ki-meta-row"><%= item.jenis === 'Paten' ? 'Tahun pengajuan' : 'Tahun' %>: <%= item.tahun || 'Belum tersedia' %></div>
            <% if (item.status_raw) { %><div class="ki-meta-row">Status: <%= item.status_raw %></div><% } %>
            <% if (item.no_permohonan) { %><div class="ki-meta-row">No. permohonan: <%= item.no_permohonan %></div><% } %>
            <div class="ki-meta-row ki-meta-fakultas"><%= item.fakultas %></div>
          </div>
        </a>
      <% }) %>
    </div>

    <% if (totalPages > 1) { %>
      <div style="display:flex;gap:8px;margin-top:24px;justify-content:center;flex-wrap:wrap;">
        <% for (let p = 1; p <= totalPages; p++) { %>
          <a class="btn-secondary" style="padding:8px 14px;font-size:12px;<%= p === page ? 'background:var(--navy);color:var(--paper);' : '' %>"
             aria-label="Halaman <%= p %>" <%- p === page ? 'aria-current="page"' : '' %> href="/direktori?<%= baseQueryString %>&page=<%= p %>"><%= p %></a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<script src="/js/main.js" defer></script>
<%- include('partials/footer') %>
