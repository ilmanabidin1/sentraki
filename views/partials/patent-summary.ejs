<%
  const totalPatenNum = patentTotals['total'] || 1;
  const pctGranted = Math.round(((patentTotals['granted'] || 0) / totalPatenNum) * 100);
  const pctProses = Math.round(((patentTotals['proses'] || 0) / totalPatenNum) * 100);
  const pctDitolak = Math.round(((patentTotals['ditolak'] || 0) / totalPatenNum) * 100);
%>
<section class="patent-summary" aria-labelledby="patent-summary-title">
  <div class="patent-summary-card">
    <div class="patent-summary-heading">
      <div>
        <h1 id="patent-summary-title" class="section-title">Pantau Status Portofolio Paten</h1>
        <p class="section-subtitle">Ringkasan status paten dari rekap Unisba berdasarkan tahun pengajuan. Ini bukan pemantauan langsung atau riwayat status tahunan DJKI.</p>
      </div>
      <a class="btn-outline-action" href="<%= filterUrl({ jenis: ['Paten'], status: [], tahun: [] }) %>">
        <span>Buka Semua Paten di Direktori</span>
        <svg width="14" height="14" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#right"/></svg>
      </a>
    </div>

    <!-- Visual Distribution Bar -->
    <div class="patent-distribution-wrap">
      <div class="distribution-header">
        <span>Distribusi Status Paten Terdaftar</span>
        <span class="distribution-legend">
          <span class="legend-item"><span class="legend-dot granted"></span> Granted (<%= pctGranted %>%)</span>
          <span class="legend-item"><span class="legend-dot proses"></span> Dalam Proses (<%= pctProses %>%)</span>
          <span class="legend-item"><span class="legend-dot ditolak"></span> Ditolak/Ditarik (<%= pctDitolak %>%)</span>
        </span>
      </div>
      <div class="distribution-bar" title="Distribusi status paten">
        <div class="bar-segment granted" style="width: <%= pctGranted %>%;"></div>
        <div class="bar-segment proses" style="width: <%= pctProses %>%;"></div>
        <div class="bar-segment ditolak" style="width: <%= pctDitolak %>%;"></div>
      </div>
    </div>

    <!-- Stat Metric Cards -->
    <div class="patent-stats">
      <a class="patent-stat patent-stat-total" href="<%= filterUrl({ jenis: ['Paten'], status: [], tahun: [] }) %>">
        <div class="stat-icon-wrap total">
          <svg width="20" height="20" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#document"/></svg>
        </div>
        <div class="stat-meta">
          <span class="stat-label">Total Permohonan Paten</span>
          <strong class="stat-number"><%= patentTotals['total'].toLocaleString('id-ID') %></strong>
          <span class="stat-action">Lihat seluruh paten &rarr;</span>
        </div>
      </a>

      <a class="patent-stat patent-stat-granted" href="<%= filterUrl({ jenis: ['Paten'], status: ['granted'], tahun: [] }) %>">
        <div class="stat-icon-wrap granted">
          <svg width="20" height="20" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#certificate"/></svg>
        </div>
        <div class="stat-meta">
          <span class="stat-label">Granted (Telah Diberikan)</span>
          <strong class="stat-number"><%= patentTotals['granted'].toLocaleString('id-ID') %></strong>
          <span class="stat-action"><%= pctGranted %>% dari total invensi</span>
        </div>
      </a>

      <a class="patent-stat patent-stat-proses" href="<%= filterUrl({ jenis: ['Paten'], status: ['proses'], tahun: [] }) %>">
        <div class="stat-icon-wrap proses">
          <svg width="20" height="20" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#clock"/></svg>
        </div>
        <div class="stat-meta">
          <span class="stat-label">Dalam Pemeriksaan DJKI</span>
          <strong class="stat-number"><%= patentTotals['proses'].toLocaleString('id-ID') %></strong>
          <span class="stat-action"><%= pctProses %>% dalam proses tinjauan</span>
        </div>
      </a>

      <a class="patent-stat patent-stat-ditolak" href="<%= filterUrl({ jenis: ['Paten'], status: ['ditolak'], tahun: [] }) %>">
        <div class="stat-icon-wrap ditolak">
          <svg width="20" height="20" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#rejected"/></svg>
        </div>
        <div class="stat-meta">
          <span class="stat-label">Ditolak / Ditarik</span>
          <strong class="stat-number"><%= patentTotals['ditolak'].toLocaleString('id-ID') %></strong>
          <span class="stat-action"><%= pctDitolak %>% dari total</span>
        </div>
      </a>
    </div>

    <!-- Yearly Breakdown Table -->
    <details class="patent-breakdown" open>
      <summary class="breakdown-summary">
        <div class="breakdown-summary-left">
          <svg width="18" height="18" class="sk-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#calendar"/></svg>
          <span>Rincian Status per Tahun Pengajuan</span>
        </div>
        <svg class="breakdown-toggle-icon sk-icon" width="16" height="16" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=91db9cf6f1#down"/></svg>
      </summary>
      <div class="breakdown-content">
        <p class="filter-help">Klik pada angka di tabel untuk langsung melihat daftar paten sesuai tahun dan status pengajuannya.</p>
        <div class="patent-table-wrap">
          <table class="patent-table">
            <thead>
              <tr>
                <th class="col-year">Tahun Pengajuan</th>
                <th class="col-granted">Granted</th>
                <th class="col-proses">Dalam Proses</th>
                <th class="col-ditolak">Ditolak / Ditarik</th>
                <th class="col-total">Total Permohonan</th>
              </tr>
            </thead>
            <tbody>
              <% patentYears.forEach(row => { %>
                <tr>
                  <td class="cell-year">
                    <span class="year-badge"><%= row.tahun === 'unknown' ? 'Belum tersedia' : row.tahun %></span>
                  </td>
                  <td class="cell-num cell-granted">
                    <a class="table-chip granted" href="<%= filterUrl({ jenis: ['Paten'], status: ['granted'], tahun: [row.tahun] }) %>">
                      <%= row.granted.toLocaleString('id-ID') %>
                    </a>
                  </td>
                  <td class="cell-num cell-proses">
                    <a class="table-chip proses" href="<%= filterUrl({ jenis: ['Paten'], status: ['proses'], tahun: [row.tahun] }) %>">
                      <%= row.proses.toLocaleString('id-ID') %>
                    </a>
                  </td>
                  <td class="cell-num cell-ditolak">
                    <a class="table-chip ditolak" href="<%= filterUrl({ jenis: ['Paten'], status: ['ditolak'], tahun: [row.tahun] }) %>">
                      <%= row.ditolak.toLocaleString('id-ID') %>
                    </a>
                  </td>
                  <td class="cell-num cell-total">
                    <a class="table-chip total" href="<%= filterUrl({ jenis: ['Paten'], status: [], tahun: [row.tahun] }) %>">
                      <%= row.total.toLocaleString('id-ID') %>
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </details>
  </div>
</section>
