<aside class="ki-assistant" id="kiAssistant">
  <section class="ki-chat-panel" id="kiChatPanel" role="region" aria-labelledby="kiChatTitle" hidden>
    <header class="ki-chat-header">
      <svg class="sk-icon" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#assistant"/></svg>
      <div><h2 id="kiChatTitle">Asisten KI</h2><p>P2KI UNISBA</p></div>
      <button id="kiChatClose" type="button" aria-label="Tutup chat"><svg class="sk-icon" width="20" height="20" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#close"/></svg></button>
    </header>
    <div class="ki-chat-log" id="aiLog" role="log" aria-live="polite" aria-relevant="additions text">
      <div class="ki-chat-message bot"><span class="ki-chat-author">Asisten KI</span><div class="bubble">Assalamu'alaikum! Ada yang ingin Anda tanyakan tentang perlindungan karya, pendaftaran KI, atau modul belajar?</div></div>
    </div>
    <div class="ki-chat-prompts" aria-label="Pertanyaan cepat">
      <button type="button" data-ai-prompt="Apa bedanya paten biasa dan paten sederhana?">Jenis paten</button>
      <button type="button" data-ai-prompt="Modul apa untuk belajar hak cipta?">Modul hak cipta</button>
      <button type="button" data-ai-prompt="Bagaimana alur pendaftaran KI di Unisba?">Alur pengajuan</button>
    </div>
    <form class="ki-chat-form" id="kiChatForm">
      <label class="sr-only" for="aiInput">Pertanyaan untuk Asisten AI</label>
      <textarea id="aiInput" rows="2" maxlength="2000" placeholder="Tulis pertanyaan Anda…" required></textarea>
      <button type="submit" id="kiChatSend" aria-label="Kirim pertanyaan"><svg class="sk-icon" width="20" height="20" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#send"/></svg></button>
    </form>
    <p class="ki-chat-note" id="kiChatNote"><%= typeof aiEnabled !== 'undefined' && aiEnabled ? 'Asisten AI' : 'Panduan otomatis' %> · Rujuk dokumen resmi untuk keputusan KI.</p>
  </section>
  <button class="ki-chat-launcher" id="kiChatToggle" type="button" aria-expanded="false" aria-controls="kiChatPanel" aria-label="Buka Asisten KI">
    <svg class="sk-icon" width="24" height="24" viewBox="0 0 32 32" aria-hidden="true"><use href="/icons/sentra-ki.svg?v=1a3db9681d#assistant"/></svg><span>Asisten KI</span>
  </button>
</aside>
