<%- include('partials/head', { title: 'Pelajari KI & Asisten AI' }) %>
<%- include('partials/nav', { active: 'pelajari' }) %>

<main class="page-container section-narrow" style="max-width: 860px;">
  <header class="page-header-center">
    <h1 class="page-title">Panduan &amp; Pembelajaran KI</h1>
    <p class="page-desc">Disarikan dari modul resmi pelatihan bersama DJKI Kemenkumham RI, disajikan ringkas dan terstruktur untuk memandu inventor kampus dari hulu ke hilir.</p>
  </header>

  <!-- MODULE ACCORDIONS -->
  <div class="learning-modules-list" id="moduleList">
    <% modules.forEach((m, i) => { %>
      <div class="modern-module-card <%= i === 0 ? 'open' : '' %>" id="module-<%= i %>">
        <button class="module-head-btn" type="button" onclick="toggleModule(<%= i %>)" aria-expanded="<%= i === 0 ? 'true' : 'false' %>">
          <div class="module-head-left">
            <div class="module-index-badge"><%= String(i + 1).padStart(2, '0') %></div>
            <div class="module-text-meta">
              <h3 class="module-title"><%= m.title %></h3>
              <span class="module-duration"><%= m.meta %></span>
            </div>
          </div>
          <div class="module-toggle-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
        </button>

        <div class="module-collapsible-body">
          <div class="module-body-inner">
            <ul class="module-points-list">
              <% m.points.forEach(p => { %>
                <li>
                  <svg class="point-check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span><%= p %></span>
                </li>
              <% }) %>
            </ul>
            <div class="module-source-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Disarikan dari silabus kurikulum pelatihan DJKI Kemenkumham</span>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- MODERN AI ASSISTANT WIDGET -->
  <section class="ai-assistant-card">
    <div class="ai-card-glow"></div>
    <div class="ai-card-header">
      <div class="ai-avatar-badge">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
      </div>
      <div class="ai-header-text">
        <h3 class="ai-title">Tanya Asisten AI Sentra KI</h3>
        <p class="ai-desc">Tanyakan seputar jenis KI, perbedaan paten sederhana, alur pendaftaran, atau pembagian manfaat ekonomi.</p>
      </div>
    </div>

    <!-- PROMPT CHIPS -->
    <div class="ai-prompt-chips">
      <span class="prompt-chip-label">Pilihan Cepat:</span>
      <button type="button" class="ai-chip-btn" onclick="askAI('Apa bedanya paten biasa dan paten sederhana?')">Beda Paten Biasa &amp; Sederhana?</button>
      <button type="button" class="ai-chip-btn" onclick="askAI('Berapa lama proses sertifikasi hak cipta?')">Lama Proses Hak Cipta?</button>
      <button type="button" class="ai-chip-btn" onclick="askAI('Apa saja syarat invensi agar bisa dipatenkan?')">Syarat Invensi Paten?</button>
      <button type="button" class="ai-chip-btn" onclick="askAI('Bagaimana pembagian royalti lisensi untuk inventor kampus?')">Pembagian Royalti Inventor?</button>
    </div>

    <!-- CHAT LOG -->
    <div class="ai-chat-log" id="aiLog" role="log" aria-live="polite">
      <div class="ai-msg bot">
        <div class="msg-avatar-mini">AI</div>
        <div class="msg-bubble-wrap">
          <div class="msg-author">Asisten AI Sentra KI</div>
          <div class="bubble">
            Assalamu'alaikum! Selamat datang di Pusat Edukasi Sentra KI UNISBA. Silakan ajukan pertanyaan seputar perlindungan karya intelektual Anda, atau pilih salah satu topik cepat di atas.
          </div>
        </div>
      </div>
    </div>

    <!-- CHAT INPUT -->
    <div class="ai-input-bar">
      <input type="text" id="aiInput" class="ai-text-input" placeholder="Tuliskan pertanyaan seputar KI..." aria-label="Pertanyaan untuk Asisten AI" onkeydown="if(event.key==='Enter'){sendAIQuestion();}">
      <button type="button" class="btn-ai-send" onclick="sendAIQuestion()" aria-label="Kirim Pertanyaan">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </div>

    <div class="ai-disclaimer-note" id="aiDisclaimer">
      <span><%= aiEnabled ? 'Terhubung ke model cerdas AI Sentra KI.' : 'Mode cerdas responsif Sentra KI LPPM UNISBA.' %> Jawaban bersifat edukasi &amp; konsultatif.</span>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
