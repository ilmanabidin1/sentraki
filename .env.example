# Salin file ini menjadi .env untuk pengembangan lokal.
# Database memakai SQLite (file lokal), tidak perlu setup database terpisah
# baik di lokal maupun di Railway. File database dibuat otomatis di data/p2ki.db.

# Ganti dengan kredensial yang kuat sebelum deploy ke production.
# Password ini di-hash bcrypt saat akun admin pertama kali dibuat (tidak pernah disimpan plaintext).
# PENTING: akun admin dibuat sekali saat start pertama. Mengubah ADMIN_PASSWORD di env
# setelahnya TIDAK mengubah akun yang sudah ada — hapus tabel admin_users (atau file .db)
# untuk re-seed kredensial.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Kunci rahasia untuk session cookie. Ganti dengan string acak yang panjang di production.
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang

# Opsional: isi untuk mengaktifkan jawaban AI sungguhan (Claude) di tab "Pelajari KI" dan "Konsultasi".
# Jika dikosongkan, sistem otomatis memakai jawaban rule-based (tetap berfungsi tanpa key ini).
ANTHROPIC_API_KEY=
